{
    "name": "pl_load_usd_cad",
    "properties": {
        "activities": [
            {
                "name": "GetValetRates",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "url": "@concat('https://www.bankofcanada.ca/valet/observations/FXUSDCAD/json?start_date=', pipeline().parameters.StartDate, '&end_date=', pipeline().parameters.EndDate)"
                }
            },
            {
                "name": "Load USDCAD",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "GetValetRates",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "storedProcedureName": "[dbo].[LoadUsdCad]",
                    "storedProcedureParameters": {
                        "ObservationsJson": {
                            "value": "@string(activity('GetValetRates').output.observations)",
                            "type": "String"
                        },
                        "PipelineRunId": {
                            "value": "@pipeline().RunId",
                            "type": "Guid"
                        }
                    }
                },
                "linkedServiceName": {
                    "referenceName": "ls_azure_sql_boc_fx",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "If Condition1",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Load USDCAD",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@pipeline().parameters.CheckFreshness",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Stored procedure1",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[dbo].[CheckUsdCadFreshness]",
                                "storedProcedureParameters": {
                                    "CheckDate": {
                                        "value": "@pipeline().parameters.EndDate",
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_azure_sql_boc_fx",
                                "type": "LinkedServiceReference"
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "StartDate": {
                "type": "string"
            },
            "EndDate": {
                "type": "string"
            },
            "CheckFreshness": {
                "type": "bool",
                "defaultValue": false
            }
        },
        "annotations": []
    }
}